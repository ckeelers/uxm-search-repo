{
  "name": "searchexperience",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @searchexperience/core test",
    "dev:web": "pnpm --filter @searchexperience/web dev",
    "dev:worker": "pnpm --filter @searchexperience/worker dev",
    "crawl": "pnpm --filter @searchexperience/worker crawl",
    "db:generate": "pnpm --filter @searchexperience/core db:generate",
    "db:migrate": "pnpm --filter @searchexperience/core db:migrate",
    "db:deploy": "pnpm --filter @searchexperience/core db:deploy",
    "db:studio": "pnpm --filter @searchexperience/core db:studio"
  }
}
