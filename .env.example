# Copy to .env for local dev. Never commit .env.

# Postgres connection string (Railway provides this in production).
DATABASE_URL="postgresql://user:password@localhost:5432/searchexperience?schema=public"

# --- web: /admin basic auth (plan §6) ---
ADMIN_USER="admin"
ADMIN_PASS="change-me"

# --- worker: crawl behaviour (plan §5.5, §3) ---
CRAWL_MAX_RUNTIME_MS="900000"
CLOSE_AFTER_MISSED_CRAWLS="2"
CRAWL_USER_AGENT="searchexperience-bot/0.1 (+contact: ck.sanford@protonmail.com)"
